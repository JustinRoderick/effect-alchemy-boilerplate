{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "import/no-cycle": "error",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_tag"]
      }
    ]
  },
  "ignorePatterns": ["template/**", ".repos/**", "dist/**", "docs/**"]
}
