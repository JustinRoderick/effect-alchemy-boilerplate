# Copy to .env for local overrides. Alchemy loads .env automatically; anything
# the Worker reads with effect/Config during construction is bound as a secret.

# Optional: maximum number of todos (default 100).
# MAX_TODOS=100

# Optional: comma-separated origins allowed to call the API from a browser.
# Empty (the default) allows any origin. Set it to your web URL in production.
# ALLOWED_ORIGINS=https://web.example.com

# Optional: stage to deploy to instead of live_$USER / dev_$USER.
# ALCHEMY_STAGE=prod

# CI only: locally, `alchemy profile` stores Cloudflare credentials for you.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
