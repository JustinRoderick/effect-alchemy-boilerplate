{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "printWidth": 100,
  "trailingComma": "all",
  "sortPackageJson": true,
  "ignorePatterns": [
    ".alchemy/**",
    ".repos/**",
    "**/dist/**",
    "**/*.md",
    "docs/**",
    "pnpm-lock.yaml"
  ]
}
